# Backend environment template — copy to `backend/.env` and fill in.
# server.js loads this file via dotenv when run from the backend directory.

# Server
PORT=5000
FRONTEND_URL=http://localhost:8080
NODE_ENV=development
# Set to "production" ONLY when Firebase Admin credentials are configured below.
# In production, missing Firebase creds will refuse to start (fail-closed).

# JWT
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# CORS (comma-separated list of allowed front-end origins for deployment)
# Leave empty to allow the local dev origins only.
CORS_ORIGINS=

# Allow the verification code to be returned in the API response (dev only).
# Must be explicitly "true"; never set this in production.
ALLOW_DEV_CODE=false

# Path to the JSON file used for local persistence (survives restarts).
DATA_FILE=

# Firebase Admin (Backend) — Service Account credentials
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com

# Email (SMTP) — Optional, used for verification / password reset emails
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=UniTally <noreply@unitally.com>

# --- AI parse proxy (backend/routes/ai.js) ---
# Platform upstream, any OpenAI-compatible endpoint (DeepSeek / GLM / ...).
# Leave OPENAI_API_KEY empty to disable /api/ai/parse (it answers 503 "AI proxy not configured").
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat
# Daily per-user parse quota through the platform proxy (BYOK / local Ollama requests
# never hit this endpoint and are unlimited). Defaults: free 5 / premium 30.
AI_QUOTA_FREE=5
AI_QUOTA_PREMIUM=30
# Context window passed to LOCAL Ollama models by the FRONTEND (options.num_ctx).
# The backend proxy itself always targets the cloud upstream above.
AI_NUM_CTX=4096
