# Firebase Configuration (Frontend)
# Get these from Firebase Console > Project Settings > General > Your Apps
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend Configuration
PORT=5000
FRONTEND_URL=http://localhost:8080
NODE_ENV=development
# Set to "production" ONLY with valid Firebase Admin creds below; otherwise the
# backend refuses to start (fail-closed auth).
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# CORS: comma-separated list of allowed front-end origins for deployment.
# Leave empty to allow the local dev origins only.
CORS_ORIGINS=

# Dev only: return the email verification code in the API response.
# Must be explicitly "true"; never enable in production.
ALLOW_DEV_CODE=false

# Local persistence file (survives restarts). Empty = backend/data/db.json.
DATA_FILE=

# Firebase Admin (Backend)
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com

# Email Configuration (Optional - for email verification)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Local persistence (file-backed, survives restarts). No external DB required.
# The backend writes a JSON file; see DATA_FILE above.
# (MongoDB / mongoose support was removed — persistence is now file-based.)
